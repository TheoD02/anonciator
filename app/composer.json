{
  "name": "symfony/skeleton",
  "type": "project",
  "license": "MIT",
  "description": "A minimal Symfony project recommended to create bare bones applications",
  "minimum-stability": "stable",
  "prefer-stable": true,
  "require": {
    "php": ">=8.4",
    "ext-ctype": "*",
    "ext-iconv": "*",
    "doctrine/dbal": "^4.5",
    "doctrine/doctrine-bundle": "^3.3.2",
    "doctrine/doctrine-fixtures-bundle": "^4.3",
    "doctrine/doctrine-migrations-bundle": "^4.0.1",
    "doctrine/orm": "^3.7",
    "jolicode/automapper": "^10.3",
    "lexik/jwt-authentication-bundle": "^3.2",
    "nelmio/api-doc-bundle": "^5.13.1",
    "nelmio/cors-bundle": "^2.5",
    "phpdocumentor/reflection-docblock": "^6.0.3",
    "phpstan/phpdoc-parser": "^2.0",
    "stof/doctrine-extensions-bundle": "^1.15",
    "symfony/asset": "8.1.*",
    "symfony/console": "8.1.*",
    "symfony/dotenv": "8.1.*",
    "symfony/event-dispatcher": "8.1.*",
    "symfony/flex": "^2.4.7",
    "symfony/framework-bundle": "8.1.*",
    "symfony/json-streamer": "8.1.*",
    "symfony/mercure-bundle": "^0.6.1",
    "symfony/mime": "8.1.*",
    "symfony/monolog-bundle": "^4.1",
    "symfony/property-access": "8.1.*",
    "symfony/property-info": "8.1.*",
    "symfony/runtime": "8.1.*",
    "symfony/security-bundle": "8.1.*",
    "symfony/serializer": "8.1.*",
    "symfony/twig-bundle": "8.1.*",
    "symfony/uid": "8.1.*",
    "symfony/validator": "8.1.*",
    "symfony/yaml": "8.1.*",
    "twig/extra-bundle": "^3.18",
    "twig/twig": "^3.18"
  },
  "config": {
    "allow-plugins": {
      "php-http/discovery": true,
      "symfony/flex": true,
      "symfony/runtime": true,
      "bamarni/composer-bin-plugin": true,
      "ergebnis/composer-normalize": true
    },
    "bump-after-update": true,
    "sort-packages": true
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "replace": {
    "symfony/polyfill-ctype": "*",
    "symfony/polyfill-iconv": "*",
    "symfony/polyfill-php72": "*",
    "symfony/polyfill-php73": "*",
    "symfony/polyfill-php74": "*",
    "symfony/polyfill-php80": "*",
    "symfony/polyfill-php81": "*",
    "symfony/polyfill-php82": "*"
  },
  "scripts": {
    "auto-scripts": {
      "cache:clear": "symfony-cmd",
      "assets:install %PUBLIC_DIR%": "symfony-cmd"
    },
    "post-install-cmd": [
      "@composer bin class-leak install --ansi",
      "@composer bin ecs install --ansi",
      "@composer bin phparkitect install --ansi",
      "@composer bin phpstan install --ansi",
      "@composer bin rector install --ansi",
      "@auto-scripts"
    ],
    "post-update-cmd": [
      "@auto-scripts"
    ],
    "qa:all": [
      "@ecs",
      "@rector",
      "@phpstan"
    ],
    "qa:all-fix": [
      "@ecs-fix",
      "@rector-fix",
      "@phpstan"
    ],
    "phpstan": "phpstan analyse --ansi --configuration vendor-bin/phpstan/phpstan.neon --memory-limit=1G -vv",
    "phpstan-pro": "phpstan clear-result-cache && phpstan analyse --ansi --configuration vendor-bin/phpstan/phpstan.neon --memory-limit=1G --pro",
    "ecs": "ecs check --ansi --config vendor-bin/ecs/ecs.php --clear-cache",
    "ecs-fix": "ecs check --ansi --config vendor-bin/ecs/ecs.php --clear-cache --fix",
    "phparkitect": "phparkitect check --ansi --config vendor-bin/phparkitect/phparkitect.php --target-php-version 8.3",
    "rector": "rector process --ansi --config vendor-bin/rector/rector.php --clear-cache --dry-run",
    "rector-fix": "rector process --ansi --config vendor-bin/rector/rector.php --clear-cache",
    "class-leak-check": "class-leak check src --skip-suffix=\"Command\" --skip-suffix=\"Controller\" --skip-suffix=\"Kernel\"",
    "phpunit": "phpunit --colors=always",
    "phpunit-coverage": "XDEBUG_MODE=coverage phpunit --colors=always --coverage-html=coverage"
  },
  "conflict": {
    "symfony/symfony": "*"
  },
  "extra": {
    "symfony": {
      "allow-contrib": false,
      "require": "8.1.*",
      "docker": "true"
    },
    "composer-normalize": {
      "indent-size": "2",
      "indent-style": "space"
    }
  },
  "require-dev": {
    "bamarni/composer-bin-plugin": "^1.8.2",
    "ergebnis/composer-normalize": "^2.45",
    "phpunit/phpunit": "^13.4.3",
    "symfony/browser-kit": "8.1.*",
    "symfony/css-selector": "8.1.*",
    "symfony/debug-bundle": "8.1.*",
    "symfony/maker-bundle": "^1.68",
    "symfony/phpunit-bridge": "^8.1.9",
    "symfony/stopwatch": "8.1.*",
    "symfony/web-profiler-bundle": "8.1.*",
    "zenstruck/foundry": "^2.14.1"
  }
}
